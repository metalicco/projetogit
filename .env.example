# Copie para .env e preencha o que for usar.

# "azul" consulta o site da Azul; "simulado" gera preços fictícios para testar.
AZUL_PROVEDOR=azul
AZUL_DB=azul_monitor.db
# 0 abre o navegador visível (ajuda se o site bloquear o modo invisível).
AZUL_HEADLESS=1
# Pausa entre a busca de uma data e a próxima, para não sobrecarregar o site.
AZUL_PAUSA_SEGUNDOS=8
# Salva as respostas brutas do site aqui (útil se a leitura dos preços quebrar).
# AZUL_DEBUG_DIR=debug

# Telegram: crie um bot com o @BotFather e descubra seu chat_id com o @userinfobot.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# E-mail (ex.: Gmail com senha de app: smtp.gmail.com, porta 587).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_DESTINO=

# ntfy.sh: instale o app ntfy no celular e assine o mesmo tópico (use um nome difícil de adivinhar).
NTFY_TOPIC=
